# ── Cluster endpoints ─────────────────────────────────────────────────────────
ES_HOST=https://<your-es-host>
KIBANA_URL=https://<your-kibana-host>

# Instruqt / k8s lab alternative names (setup.sh accepts either)
# ELASTICSEARCH_URL=http://localhost:30920
# KIBANA_URL=http://localhost:30002

# ── Auth: choose one ──────────────────────────────────────────────────────────

# Option A — username / password (Instruqt / on-prem / k8s ECK)
# In k8s Instruqt labs the password is pulled automatically from the ECK
# operator secret (elasticsearch-es-elastic-user). Set only if running outside
# Instruqt or to override the secret value.
ES_USERNAME=elastic
ES_PASSWORD=<your-password>

# Instruqt alternative names (setup.sh accepts either)
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=<your-password>

# Option B — pre-issued API key (Elastic Cloud)
# ES_API_KEY=<id:api_key base64 encoded>

# ── ECH bulk ingest endpoint (optional) ───────────────────────────────────────
# Speeds up the 330k doc load on ECH deployments that expose a separate
# ingest endpoint. Leave unset if not applicable.
# ES_HOST_BULK=https://<your-ingest-endpoint>/_es
